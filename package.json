{
  "name": "imgurpass",
  "version": "0.1.0",
  "description": "Unofficial extension that loads Imgur images, videos and albums where Imgur is blocked. Not affiliated with Imgur.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "happy-dom": "21.0.4",
    "typescript": "^5.9.3",
    "vitest": "5.1.1",
    "wxt": "0.21.5"
  },
  "packageManager": "pnpm@12.21.0"
}
